# Discord OAuth2 Join Flow — Environment Variables
# Copy this file to .env and fill in the values before starting the server.
# Never commit .env to version control.

# ---------------------------------------------------------------------------
# Required — Discord application credentials
# Create an application at https://discord.com/developers/applications
# ---------------------------------------------------------------------------

# Your Discord application's client ID (found on the OAuth2 page)
DISCORD_CLIENT_ID=your_discord_client_id_here

# Your Discord application's client secret (keep this secret!)
DISCORD_CLIENT_SECRET=your_discord_client_secret_here

# The OAuth2 redirect URI registered in your Discord application settings
# Must exactly match one of the redirect URIs configured in the Discord portal
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# The ID of the Discord guild (server) users will be added to
DISCORD_GUILD_ID=your_discord_guild_id_here

# The bot token used to add members to the guild via the Discord API
# The bot must be a member of the target guild with the "Create Instant Invite"
# and "Manage Members" permissions
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# ---------------------------------------------------------------------------
# Required — Security secrets
# Use long, random strings (e.g. openssl rand -hex 32)
# ---------------------------------------------------------------------------

# Secret used to sign the oauth_state cookie (prevents tampering)
COOKIE_SECRET=replace_with_a_long_random_secret_string

# Salt appended to IP addresses before SHA-256 hashing (analytics)
IP_HASH_SALT=replace_with_a_long_random_ip_salt_string

# Salt appended to User-Agent strings before SHA-256 hashing (analytics)
UA_HASH_SALT=replace_with_a_long_random_ua_salt_string

# ---------------------------------------------------------------------------
# Optional — Server settings
# ---------------------------------------------------------------------------

# Port the HTTP server listens on (default: 3000)
PORT=3000

# Application environment: development | production | test (default: development)
NODE_ENV=development

# ---------------------------------------------------------------------------
# Optional — Database
# Leave unset to run without database persistence (Requirement 8.7)
# ---------------------------------------------------------------------------

# PostgreSQL connection string — omit to disable database persistence
# DATABASE_URL=postgresql://user:password@localhost:5432/discord_oauth

# ---------------------------------------------------------------------------
# Optional — Custom welcome DM feature
# ---------------------------------------------------------------------------

# Set to "true" to send a custom DM to newly joined users (default: false)
CUSTOM_DM_ENABLED=false

# The message sent to newly joined users when CUSTOM_DM_ENABLED=true
CUSTOM_WELCOME_MESSAGE=Welcome!

# ---------------------------------------------------------------------------
# Optional — Redirect allowlist
# ---------------------------------------------------------------------------

# Comma-separated list of allowed redirect URL prefixes for post-join redirects.
# The first entry is used as the default destination (default: /success)
REDIRECT_ALLOWLIST=/success
